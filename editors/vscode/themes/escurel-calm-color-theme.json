{
  "$schema": "vscode://schemas/color-theme",
  "name": "Escurel Calm",
  "type": "light",
  "colors": {
    "foreground": "#2b3036",
    "descriptionForeground": "#58626c",
    "disabledForeground": "#8a929a",
    "errorForeground": "#b3261e",
    "focusBorder": "#1f6f78",
    "widget.border": "#d8d4cb",
    "contrastBorder": "#d8d4cb",
    "textLink.foreground": "#17606a",
    "textLink.activeForeground": "#0f4a52",
    "editor.background": "#fbfaf8",
    "editor.foreground": "#2b3036",
    "editorWidget.background": "#f6f4ef",
    "editorWarning.foreground": "#8a5a00",
    "editorError.foreground": "#b3261e",
    "editorLineNumber.foreground": "#9aa1a8",
    "editorGroup.border": "#e4e0d8",
    "editorGroupHeader.tabsBackground": "#f3f1ec",
    "tab.activeBackground": "#fbfaf8",
    "tab.inactiveBackground": "#f3f1ec",
    "tab.activeForeground": "#2b3036",
    "tab.inactiveForeground": "#58626c",
    "tab.border": "#e4e0d8",
    "sideBar.background": "#f3f1ec",
    "sideBar.foreground": "#2b3036",
    "sideBar.border": "#e4e0d8",
    "sideBarTitle.foreground": "#2b3036",
    "sideBarSectionHeader.background": "#ebe8e1",
    "sideBarSectionHeader.foreground": "#2b3036",
    "activityBar.background": "#ebe8e1",
    "activityBar.foreground": "#1f6f78",
    "activityBar.inactiveForeground": "#58626c",
    "activityBar.border": "#e4e0d8",
    "activityBarBadge.background": "#1f6f78",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#ebe8e1",
    "titleBar.activeForeground": "#2b3036",
    "titleBar.inactiveBackground": "#f3f1ec",
    "titleBar.inactiveForeground": "#58626c",
    "titleBar.border": "#e4e0d8",
    "statusBar.background": "#1f6f78",
    "statusBar.foreground": "#ffffff",
    "panel.background": "#f6f4ef",
    "panel.border": "#e4e0d8",
    "panelTitle.activeForeground": "#2b3036",
    "panelTitle.inactiveForeground": "#58626c",
    "button.background": "#1f6f78",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#195b63",
    "button.secondaryBackground": "#e4e0d8",
    "button.secondaryForeground": "#2b3036",
    "badge.background": "#1f6f78",
    "badge.foreground": "#ffffff",
    "input.background": "#ffffff",
    "input.foreground": "#2b3036",
    "input.border": "#c9c4b9",
    "list.activeSelectionBackground": "#d6e7e8",
    "list.activeSelectionForeground": "#14363a",
    "list.inactiveSelectionBackground": "#e4e9e6",
    "list.inactiveSelectionForeground": "#2b3036",
    "list.hoverBackground": "#ebe8e1",
    "list.focusOutline": "#1f6f78",
    "charts.green": "#2c7a4b",
    "charts.orange": "#9a5300",
    "charts.blue": "#2b5fa8",
    "charts.purple": "#6b4fa0",
    "charts.red": "#b3261e",
    "charts.yellow": "#8a5a00",
    "progressBar.background": "#1f6f78",
    "scrollbarSlider.background": "#c9c4b966",
    "scrollbarSlider.hoverBackground": "#b3ada0aa"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#6b737b", "fontStyle": "italic" } },
    { "scope": ["string"], "settings": { "foreground": "#2c7a4b" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#6b4fa0" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#9a5300" } },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#2b5fa8" }
    },
    {
      "scope": ["entity.name.tag", "markup.heading"],
      "settings": { "foreground": "#17606a", "fontStyle": "bold" }
    }
  ]
}
