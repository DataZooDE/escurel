      {
        "viewType": "escurel.pageAsUi",
        "displayName": "Escurel Page",
        "selector": [
          {
            "filenamePattern": "escurel:/instances/**/*.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "escurel.skillPage",
        "displayName": "Escurel Skill",
        "selector": [
          {
            "filenamePattern": "escurel:/skills/**/*.md"
          }
        ],
        "priority": "default"
      }
