  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "lint": "eslint . && node scripts/lint-hex.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:component": "web-test-runner",
    "test:visual": "scripts/visual.sh",
    "test:integration": "node esbuild.mjs --production && node ./dist/test/integration/runTests.js",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:component",
    "package": "npm run build && vsce package -o escurel-$npm_package_version.vsix",
    "test:visual:update": "scripts/visual.sh --update-snapshots=all",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "lit": "^3.2.0",
    "loro-crdt": "1.16.3",
    "ws": "^8.18.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@open-wc/testing": "^4.0.0",
    "@playwright/test": "1.63.0",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.7.0",
    "@types/vscode": "1.104.0",
    "@types/ws": "^8.5.12",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "@web/dev-server-esbuild": "^1.0.3",
    "@web/test-runner": "^0.19.0",
    "@web/test-runner-playwright": "^0.11.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^16.5.0",
    "mocha": "^10.7.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The extension only talks to the configured escurel gateway. In a Restricted Mode window the gateway and sign-in settings come from your user settings, never from the folder.",
      "restrictedConfigurations": [
        "escurel.gatewayUrl",
        "escurel.evolveEndpoint",
        "escurel.auth.issuer",
        "escurel.auth.clientId",
        "escurel.auth.scopes",
        "escurel.shellHarness",
        "escurel.harness"
      ]
    },
    "virtualWorkspaces": true
  }
}
