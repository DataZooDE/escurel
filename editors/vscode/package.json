{
  "name": "escurel",
  "displayName": "Escurel Workbench",
  "description": "Skills, instances, events and runs of an escurel gateway, inside VS Code.",
  "version": "0.1.0",
  "publisher": "datazoo",
  "license": "SEE LICENSE IN ../../LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/DataZooDE/escurel",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.104.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onAuthenticationRequest:escurel",
    "onCommand:escurel.search",
    "onCommand:escurel.showDetails",
    "onCommand:escurel.showRunner",
    "onFileSystem:escurel",
    "onView:escurel.awaiting",
    "onView:escurel.details",
    "onView:escurel.inbox",
    "onView:escurel.knowledge",
    "onView:escurel.runner",
    "onView:escurel.threads"
  ],
  "contributes": {
    "configuration": {
      "title": "Escurel",
      "properties": {
        "escurel.gatewayUrl": {
          "type": "string",
          "scope": "application",
          "default": "http://127.0.0.1:8080",
          "description": "The one escurel gateway this window talks to (its /mcp and /ws live under this origin)."
        },
        "escurel.auth.issuer": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "OIDC issuer URL for signing in (the gateway trusts it). Leave empty for a gateway that runs without a verifier (dev / on-host): no token is sent."
        },
        "escurel.auth.clientId": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "Public OIDC client id for the PKCE / device-code flow."
        },
        "escurel.auth.scopes": {
          "type": "array",
          "scope": "application",
          "items": {
            "type": "string"
          },
          "default": [
            "openid",
            "profile",
            "offline_access"
          ],
          "description": "Scopes requested at sign-in."
        },
        "escurel.shellHarness": {
          "type": "string",
          "default": "claude",
          "scope": "application",
          "description": "Command started in the integrated terminal by \"Start in terminal\"."
        },
        "escurel.harness": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "The harness to ask the runner for; empty = the runner's default; a name the runner does not allow makes the run fail."
        }
      }
    },
    "commands": [
      {
        "command": "escurel.signIn",
        "title": "Sign in",
        "category": "Escurel"
      },
      {
        "command": "escurel.signOut",
        "title": "Sign out",
        "category": "Escurel"
      },
      {
        "command": "escurel.refresh",
        "title": "Refresh",
        "category": "Escurel",
        "icon": "$(refresh)"
      },
      {
        "command": "escurel.search",
        "title": "Search…",
        "category": "Escurel",
        "icon": "$(search)"
      },
      {
        "command": "escurel.resolve",
        "title": "Resolve wikilink\u2026",
        "category": "Escurel"
      },
      {
        "command": "escurel.openPage",
        "title": "Open page",
        "category": "Escurel"
      },
      {
        "command": "escurel.openInstance",
        "title": "Open instance",
        "icon": "$(go-to-file)",
        "category": "Escurel"
      },
      {
        "command": "escurel.viewSkill",
        "title": "View skill",
        "category": "Escurel"
      },
      {
        "command": "escurel.showRaw",
        "title": "Show Markdown",
        "category": "Escurel",
        "icon": "$(code)"
      },
      {
        "command": "escurel.startSkill",
        "title": "Start skill…",
        "category": "Escurel"
      },
      {
        "command": "escurel.cancelRun",
        "title": "Cancel run",
        "icon": "$(debug-stop)",
        "category": "Escurel"
      },
      {
        "command": "escurel.retryRun",
        "title": "Retry run",
        "category": "Escurel"
      },
      {
        "command": "escurel.requeue",
        "title": "Requeue",
        "category": "Escurel",
        "enablement": "escurel.canAdmin"
      },
      {
        "command": "escurel.pauseDispatch",
        "title": "Pause dispatch",
        "icon": "$(debug-pause)",
        "category": "Escurel",
        "enablement": "escurel.canAdmin"
      },
      {
        "command": "escurel.resumeDispatch",
        "title": "Resume dispatch",
        "icon": "$(debug-continue)",
        "category": "Escurel",
        "enablement": "escurel.canAdmin"
      },
      {
        "command": "escurel.startInTerminal",
        "title": "Start in terminal",
        "category": "Escurel"
      },
      {
        "command": "escurel.openOriginal",
        "title": "Open original document",
        "category": "Escurel"
      },
      {
        "command": "escurel.approvePlan",
        "title": "Approve plan",
        "category": "Escurel"
      },
      {
        "command": "escurel.openThread",
        "title": "Open thread",
        "category": "Escurel"
      },
      {
        "command": "escurel.openRun",
        "title": "Open run",
        "category": "Escurel"
      },
      {
        "command": "escurel.openReview",
        "title": "Open review",
        "category": "Escurel"
      },
      {
        "command": "escurel.promote",
        "title": "Promote",
        "category": "Escurel",
        "icon": "$(check)"
      },
      {
        "command": "escurel.discard",
        "title": "Discard",
        "category": "Escurel",
        "icon": "$(trash)"
      },
      {
        "command": "escurel.submitComment",
        "title": "Comment",
        "category": "Escurel",
        "icon": "$(send)"
      },
      {
        "command": "escurel.knowledge.loadMore",
        "title": "Load more"
      },
      {
        "command": "escurel.proposeWriteBack",
        "title": "Propose a change to the source",
        "category": "Escurel"
      },
      {
        "command": "escurel.showDetails",
        "title": "Show details panel",
        "category": "Escurel"
      },
      {
        "command": "escurel.showRunner",
        "title": "Show runner",
        "category": "Escurel"
      },
      {
        "command": "escurel.focusCanvas",
        "title": "Focus thread canvas",
        "category": "Escurel"
      }
    ],
    "authentication": [
      {
        "id": "escurel",
        "label": "Escurel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "escurel",
          "title": "Escurel",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "escurel-runner",
          "title": "Runner",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "escurel-details",
          "title": "Escurel Details",
          "icon": "media/details.svg"
        }
      ]
    },
    "views": {
      "escurel": [
        {
          "id": "escurel.knowledge",
          "name": "Knowledge",
          "contextualTitle": "Escurel"
        },
        {
          "id": "escurel.threads",
          "name": "Threads",
          "icon": "$(git-branch)"
        },
        {
          "id": "escurel.awaiting",
          "name": "Awaiting you",
          "contextualTitle": "Escurel"
        },
        {
          "id": "escurel.inbox",
          "name": "Inbox",
          "contextualTitle": "Escurel"
        }
      ],
      "escurel-runner": [
        {
          "id": "escurel.runner",
          "name": "Runner"
        }
      ],
      "escurel-details": [
        {
          "id": "escurel.details",
          "name": "Details",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "escurel.knowledge",
        "contents": "Not connected to the escurel gateway.\n\n1. Set the gateway address.\n[Open the gateway setting](command:workbench.action.openSettings?%5B%22escurel.gatewayUrl%22%5D)\n\n2. Sign in, if your gateway asks for it.\n[Sign in](command:escurel.signIn)\n\n3. Try again.\n[Reconnect](command:escurel.refresh)\n\n[Get started](command:workbench.action.openWalkthrough?%7B%22category%22%3A%22datazoo.escurel%23escurel.start%22%7D)",
        "when": "escurel.connected == false && escurel.connectionState != 'quarantined' && escurel.connectionState != 'incompatible'"
      },
      {
        "view": "escurel.knowledge",
        "contents": "This tenant is waiting for a data migration: the page format changed (`type:` is now `kind:`), so it serves nothing else until an operator runs `escurel admin migrate-kind`.\n[Check again](command:escurel.refresh)",
        "when": "escurel.connected == false && escurel.connectionState == 'quarantined'"
      },
      {
        "view": "escurel.knowledge",
        "contents": "This gateway is older than this extension: it uses a data format the extension no longer reads. Update the gateway, or install an older extension.\n[Check again](command:escurel.refresh)",
        "when": "escurel.connected == false && escurel.connectionState == 'incompatible'"
      },
      {
        "view": "escurel.awaiting",
        "contents": "Not connected to the escurel gateway.\n\n1. Set the gateway address.\n[Open the gateway setting](command:workbench.action.openSettings?%5B%22escurel.gatewayUrl%22%5D)\n\n2. Sign in, if your gateway asks for it.\n[Sign in](command:escurel.signIn)\n\n3. Try again.\n[Reconnect](command:escurel.refresh)\n\n[Get started](command:workbench.action.openWalkthrough?%7B%22category%22%3A%22datazoo.escurel%23escurel.start%22%7D)",
        "when": "escurel.connected == false && escurel.connectionState != 'quarantined' && escurel.connectionState != 'incompatible'"
      },
      {
        "view": "escurel.awaiting",
        "contents": "This tenant is waiting for a data migration: the page format changed (`type:` is now `kind:`), so it serves nothing else until an operator runs `escurel admin migrate-kind`.\n[Check again](command:escurel.refresh)",
        "when": "escurel.connected == false && escurel.connectionState == 'quarantined'"
      },
      {
        "view": "escurel.awaiting",
        "contents": "This gateway is older than this extension: it uses a data format the extension no longer reads. Update the gateway, or install an older extension.\n[Check again](command:escurel.refresh)",
        "when": "escurel.connected == false && escurel.connectionState == 'incompatible'"
      },
      {
        "view": "escurel.inbox",
        "contents": "Not connected to the escurel gateway.\n\n1. Set the gateway address.\n[Open the gateway setting](command:workbench.action.openSettings?%5B%22escurel.gatewayUrl%22%5D)\n\n2. Sign in, if your gateway asks for it.\n[Sign in](command:escurel.signIn)\n\n3. Try again.\n[Reconnect](command:escurel.refresh)\n\n[Get started](command:workbench.action.openWalkthrough?%7B%22category%22%3A%22datazoo.escurel%23escurel.start%22%7D)",
        "when": "escurel.connected == false && escurel.connectionState != 'quarantined' && escurel.connectionState != 'incompatible'"
      },
      {
        "view": "escurel.inbox",
        "contents": "This tenant is waiting for a data migration: the page format changed (`type:` is now `kind:`), so it serves nothing else until an operator runs `escurel admin migrate-kind`.\n[Check again](command:escurel.refresh)",
        "when": "escurel.connected == false && escurel.connectionState == 'quarantined'"
      },
      {
        "view": "escurel.inbox",
        "contents": "This gateway is older than this extension: it uses a data format the extension no longer reads. Update the gateway, or install an older extension.\n[Check again](command:escurel.refresh)",
        "when": "escurel.connected == false && escurel.connectionState == 'incompatible'"
      },
      {
        "view": "escurel.runner",
        "contents": "Not connected to the escurel gateway.\n\n1. Set the gateway address.\n[Open the gateway setting](command:workbench.action.openSettings?%5B%22escurel.gatewayUrl%22%5D)\n\n2. Sign in, if your gateway asks for it.\n[Sign in](command:escurel.signIn)\n\n3. Try again.\n[Reconnect](command:escurel.refresh)\n\n[Get started](command:workbench.action.openWalkthrough?%7B%22category%22%3A%22datazoo.escurel%23escurel.start%22%7D)",
        "when": "escurel.connected == false && escurel.connectionState != 'quarantined' && escurel.connectionState != 'incompatible'"
      },
      {
        "view": "escurel.runner",
        "contents": "This tenant is waiting for a data migration: the page format changed (`type:` is now `kind:`), so it serves nothing else until an operator runs `escurel admin migrate-kind`.\n[Check again](command:escurel.refresh)",
        "when": "escurel.connected == false && escurel.connectionState == 'quarantined'"
      },
      {
        "view": "escurel.runner",
        "contents": "This gateway is older than this extension: it uses a data format the extension no longer reads. Update the gateway, or install an older extension.\n[Check again](command:escurel.refresh)",
        "when": "escurel.connected == false && escurel.connectionState == 'incompatible'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "escurel.cancelRun",
          "when": "escurel.connected"
        },
        {
          "command": "escurel.retryRun",
          "when": "escurel.connected"
        },
        {
          "command": "escurel.requeue",
          "when": "false"
        },
        {
          "command": "escurel.openPage",
          "when": "false"
        },
        {
          "command": "escurel.knowledge.loadMore",
          "when": "false"
        },
        {
          "command": "escurel.openInstance",
          "when": "false"
        },
        {
          "command": "escurel.viewSkill",
          "when": "false"
        },
        {
          "command": "escurel.startInTerminal",
          "when": "false"
        },
        {
          "command": "escurel.openOriginal",
          "when": "false"
        },
        {
          "command": "escurel.approvePlan",
          "when": "escurel.connected"
        },
        {
          "command": "escurel.openThread",
          "when": "escurel.connected"
        },
        {
          "command": "escurel.openReview",
          "when": "escurel.connected"
        },
        {
          "command": "escurel.promote",
          "when": "resourceScheme == escurel-review"
        },
        {
          "command": "escurel.discard",
          "when": "resourceScheme == escurel-review"
        },
        {
          "command": "escurel.submitComment",
          "when": "false"
        },
        {
          "command": "escurel.openRun",
          "when": "escurel.connected"
        },
        {
          "command": "escurel.proposeWriteBack",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "escurel.search",
          "when": "view == escurel.knowledge",
          "group": "navigation@1"
        },
        {
          "command": "escurel.refresh",
          "when": "view == escurel.knowledge",
          "group": "navigation@2"
        },
        {
          "command": "escurel.refresh",
          "when": "view == escurel.awaiting",
          "group": "navigation@1"
        },
        {
          "command": "escurel.refresh",
          "when": "view == escurel.inbox",
          "group": "navigation@1"
        },
        {
          "command": "escurel.refresh",
          "when": "view == escurel.threads",
          "group": "navigation"
        },
        {
          "command": "escurel.pauseDispatch",
          "when": "view == escurel.runner",
          "group": "navigation"
        },
        {
          "command": "escurel.resumeDispatch",
          "when": "view == escurel.runner",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "escurel.openInstance",
          "when": "view == escurel.knowledge && viewItem == instance",
          "group": "inline"
        },
        {
          "command": "escurel.openInstance",
          "when": "view == escurel.knowledge && viewItem == instance",
          "group": "1_open@1"
        },
        {
          "command": "escurel.viewSkill",
          "when": "view == escurel.knowledge && viewItem =~ /^(instance|skill)/",
          "group": "1_open@2"
        },
        {
          "command": "escurel.showRaw",
          "when": "view == escurel.knowledge && viewItem == instance",
          "group": "1_open@3"
        },
        {
          "command": "escurel.startSkill",
          "when": "view == escurel.knowledge && viewItem =~ /^(instance|skill)/",
          "group": "2_run@1"
        },
        {
          "command": "escurel.openInstance",
          "when": "view == escurel.inbox && viewItem =~ /hasInstance/",
          "group": "inline"
        },
        {
          "command": "escurel.openInstance",
          "when": "view == escurel.inbox && viewItem =~ /hasInstance/",
          "group": "1_open@1"
        },
        {
          "command": "escurel.showRaw",
          "when": "view == escurel.inbox && viewItem =~ /hasInstance/",
          "group": "1_open@2"
        },
        {
          "command": "escurel.promote",
          "when": "view == escurel.awaiting && viewItem =~ /^awaiting\\.(changeset|draft)$/",
          "group": "inline@1"
        },
        {
          "command": "escurel.promote",
          "when": "view == escurel.awaiting && viewItem =~ /^awaiting\\.(changeset|draft)$/",
          "group": "1_review@1"
        },
        {
          "command": "escurel.discard",
          "when": "view == escurel.awaiting && viewItem =~ /^awaiting\\.(changeset|draft)$/",
          "group": "inline@2"
        },
        {
          "command": "escurel.discard",
          "when": "view == escurel.awaiting && viewItem =~ /^awaiting\\.(changeset|draft)$/",
          "group": "1_review@2"
        },
        {
          "command": "escurel.openRun",
          "when": "view == escurel.threads && viewItem == escurel.run",
          "group": "navigation"
        },
        {
          "command": "escurel.openThread",
          "when": "view == escurel.inbox && viewItem =~ /escurel.event/",
          "group": "navigation"
        },
        {
          "command": "escurel.cancelRun",
          "when": "view == escurel.runner && viewItem == liveRun",
          "group": "inline"
        },
        {
          "command": "escurel.retryRun",
          "when": "view == escurel.runner && viewItem == deadLetter",
          "group": "1_control"
        },
        {
          "command": "escurel.requeue",
          "when": "view == escurel.runner && viewItem == deadLetter",
          "group": "1_control"
        },
        {
          "command": "escurel.resumeDispatch",
          "when": "view == escurel.runner && viewItem == paused",
          "group": "1_control"
        }
      ],
      "editor/title": [
        {
          "command": "escurel.showRaw",
          "when": "resourceScheme == escurel && activeCustomEditorId == escurel.pageAsUi",
          "group": "navigation"
        },
        {
          "command": "escurel.promote",
          "when": "resourceScheme == escurel-review",
          "group": "navigation@1"
        },
        {
          "command": "escurel.discard",
          "when": "resourceScheme == escurel-review",
          "group": "navigation@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "escurel.submitComment",
          "group": "inline@1",
          "when": "commentController == escurel-review"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "escurel.pageAsUi",
        "displayName": "Escurel Page",
        "selector": [
          {
            "filenamePattern": "escurel:/instances/**/*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "walkthroughs": [
      {
        "id": "escurel.start",
        "title": "Get started with Escurel",
        "description": "Connect to your gateway, sign in, and review your first agent proposal.",
        "steps": [
          {
            "id": "gateway",
            "title": "Set your gateway",
            "description": "Tell Escurel where your gateway runs.\n[Open the gateway setting](command:workbench.action.openSettings?%5B%22escurel.gatewayUrl%22%5D)",
            "media": {
              "markdown": "media/walkthrough/gateway.md"
            },
            "completionEvents": [
              "onSettingChanged:escurel.gatewayUrl"
            ]
          },
          {
            "id": "signin",
            "title": "Sign in",
            "description": "Sign in if your gateway asks for it.\n[Sign in](command:escurel.signIn)",
            "media": {
              "markdown": "media/walkthrough/signin.md"
            },
            "completionEvents": [
              "onCommand:escurel.signIn"
            ]
          },
          {
            "id": "review",
            "title": "Review what an agent proposed",
            "description": "Open the first item waiting for you.\n[Show Awaiting you](command:escurel.awaiting.focus)",
            "media": {
              "markdown": "media/walkthrough/review.md"
            },
            "completionEvents": [
              "onView:escurel.awaiting"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "escurel.search",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      },
      {
        "command": "escurel.showDetails",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "escurel.connected"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "lint": "eslint . && node scripts/lint-hex.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:component": "web-test-runner",
    "test:visual": "scripts/visual.sh",
    "test:integration": "node esbuild.mjs --production && node ./dist/test/integration/runTests.js",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:component",
    "package": "npm run build && vsce package -o escurel-$npm_package_version.vsix",
    "test:visual:update": "scripts/visual.sh --update-snapshots=all",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "lit": "^3.2.0",
    "loro-crdt": "1.16.3",
    "ws": "^8.18.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@open-wc/testing": "^4.0.0",
    "@playwright/test": "1.63.0",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.7.0",
    "@types/vscode": "1.104.0",
    "@types/ws": "^8.5.12",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "@web/dev-server-esbuild": "^1.0.3",
    "@web/test-runner": "^0.19.0",
    "@web/test-runner-playwright": "^0.11.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^16.5.0",
    "mocha": "^10.7.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The extension only talks to the configured escurel gateway. In a Restricted Mode window the gateway and sign-in settings come from your user settings, never from the folder.",
      "restrictedConfigurations": [
        "escurel.gatewayUrl",
        "escurel.auth.issuer",
        "escurel.auth.clientId",
        "escurel.auth.scopes",
        "escurel.shellHarness",
        "escurel.harness"
      ]
    },
    "virtualWorkspaces": true
  }
}
