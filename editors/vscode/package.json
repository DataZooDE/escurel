    "walkthroughs": [
      {
        "id": "escurel.start",
        "title": "Get started with Escurel",
        "description": "Connect to your gateway, sign in, and review your first agent proposal.",
        "steps": [
          {
            "id": "gateway",
            "title": "Set your gateway",
            "description": "Tell Escurel where your gateway runs.\n[Open the gateway setting](command:workbench.action.openSettings?%5B%22escurel.gatewayUrl%22%5D)",
            "media": {
              "markdown": "media/walkthrough/gateway.md"
            },
            "completionEvents": [
              "onSettingChanged:escurel.gatewayUrl"
            ]
          },
          {
            "id": "signin",
            "title": "Sign in",
            "description": "Sign in if your gateway asks for it.\n[Sign in](command:escurel.signIn)",
            "media": {
              "markdown": "media/walkthrough/signin.md"
            },
            "completionEvents": [
              "onCommand:escurel.signIn"
            ]
          },
          {
            "id": "review",
            "title": "Review what an agent proposed",
            "description": "Open the first item waiting for you.\n[Show Awaiting you](command:escurel.awaiting.focus)",
            "media": {
              "markdown": "media/walkthrough/review.md"
            },
            "completionEvents": [
              "onView:escurel.awaiting"
            ]
          },
          {
            "id": "runs",
            "title": "Watch and control agents",
            "description": "See what is running, what needs attention, and past runs with their traces.\n[Show Runs](command:escurel.runner.focus)",
            "media": {
              "markdown": "media/walkthrough/runs.md"
            },
            "completionEvents": [
              "onView:escurel.runner"
            ]
          },
          {
            "id": "explain",
            "title": "Learn how things connect",
            "description": "A one-screen explanation of events, skills, runs and changes.\n[Explain this view](command:escurel.explainView)",
            "media": {
              "markdown": "media/walkthrough/explain.md"
            },
            "completionEvents": [
              "onCommand:escurel.explainView"
            ]
          }
        ]
      }
    ],
    "keybindings": [
