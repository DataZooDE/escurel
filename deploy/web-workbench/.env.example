# Escurel web workbench: copy to `.env` and edit.

# --- the one secret ---------------------------------------------------------------------------
# The workbench is a remote-code-execution surface behind ONE shared password, so it refuses to start
# without a real one: at least 12 characters, and nothing that looks like a placeholder (this value is
# rejected on purpose until you change it).
WORKBENCH_PASSWORD=change-me-before-first-start
# Shortest plain password accepted (default 12; never below 8). Lowering it weakens the one gate:
# only do it for a service reachable on a private network you control.
# WORKBENCH_MIN_PASSWORD_LENGTH=8
# Better: an argon2 hash, so the secret itself is not in the environment. Generate one:
#   echo -n 'your password' | docker run --rm -i node:24-slim npx --yes argon2-cli -e
# (use single quotes when pasting it into .env; the `$` characters must stay literal)
# WORKBENCH_HASHED_PASSWORD='$argon2id$v=19$m=65536,t=3,p=4$...'

# --- exposure ---------------------------------------------------------------------------------
# 127.0.0.1 = this machine only (use an SSH tunnel or a reverse proxy). 0.0.0.0 = every interface:
# only behind TLS (see compose.proxy.yaml), never plain http on a network you do not control.
WORKBENCH_BIND=127.0.0.1
WORKBENCH_PORT=8080
# Behind a reverse proxy on another origin: the browser's origin, e.g. https://workbench.example.com
# WORKBENCH_TRUSTED_ORIGINS=
